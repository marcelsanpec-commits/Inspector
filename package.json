{
  "name": "inspectorone",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "postinstall": "npm run build:shared",
    "build:shared": "npm run build -w @inspectorone/shared",
    "dev": "npm run build:shared && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @inspectorone/api",
    "dev:web": "npm run dev -w @inspectorone/web",
    "build": "npm run build:shared && npm run build -w @inspectorone/api && npm run build -w @inspectorone/web",
    "db:generate": "npm run db:generate -w @inspectorone/api",
    "db:migrate": "npm run db:migrate -w @inspectorone/api",
    "db:reset": "npm run db:reset -w @inspectorone/api",
    "seed": "npm run seed -w @inspectorone/api --",
    "db:snapshot": "npm run db:snapshot -w @inspectorone/api",
    "test": "npm run build:shared && npm run test -w @inspectorone/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
