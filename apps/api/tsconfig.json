{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"]
  },
  // Test files are type-checked by tsconfig.test.json but kept out of dist.
  // @inspectorone/shared resolves through the workspace symlink to its built
  // dist/*.d.ts, so it must be built first - the root `build:shared` does that.
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
