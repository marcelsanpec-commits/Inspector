# Copy to .env.local and fill in. .env.local is gitignored.
# Every value here is OPTIONAL in local development - the defaults run the whole
# app with no accounts, no keys, and no network access.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave EMPTY in local dev. The API then runs PGlite (real Postgres, in-process,
# persisted to ./.data/pglite) so you need no Docker and no cloud account.
# Set this to a Neon/Supabase pooled connection string in production.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# "local" writes to ./storage and signs upload/download URLs served by the API
# itself. "s3" talks to Cloudflare R2 (or any S3-compatible service).
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inspectorone-media
# Leave blank to derive from R2_ACCOUNT_ID; set explicitly for MinIO/AWS.
S3_ENDPOINT=
S3_REGION=auto

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# "dev" trusts an x-dev-user header so you can switch roles from the portal
# without any auth provider. NEVER use this outside local development - the API
# refuses to boot with EMAIL_DRIVER=console when NODE_ENV=production.
EMAIL_DRIVER=console

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Signs local-storage upload/download tokens. A random value is generated at
# boot in development; it MUST be set explicitly in production.
SIGNING_SECRET=

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
