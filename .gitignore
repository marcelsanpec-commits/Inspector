node_modules/
dist/
build/
*.tsbuildinfo

# Secrets - never commit these
.env
.env.local
.env.*.local
# NOTE: the leading slash matters. A bare "storage/" would match a directory of
# that name at ANY depth - which silently excluded apps/api/src/storage/ from
# the repo and broke the first Render build.

# Local dev database (PGlite data directory)
/.data/

# Local storage driver output (inspection photos during dev)
/storage/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
